      "300": { "$type": "color", "$value": "#C7C1B4" },
      "600": { "$type": "color", "$value": "#4A453E" },
      "900": { "$type": "color", "$value": "#171310", "$description": "Ink — text" }
    },
    "semantic": {
      "success": { "$type": "color", "$value": "#5C7A5A" },
      "success-bg": { "$type": "color", "$value": "#E6EBE2" },
      "warning": { "$type": "color", "$value": "#9C6B2E" },
      "warning-bg": { "$type": "color", "$value": "#F1E4CE" },
