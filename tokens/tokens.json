      "900": { "$type": "color", "$value": "#121C30" }
    },
    "brass": {
      "100": { "$type": "color", "$value": "#F0E4D2" },
      "300": { "$type": "color", "$value": "#D9B98A" },
      "500": { "$type": "color", "$value": "#B38A53", "$description": "Brass — accent" },
      "700": { "$type": "color", "$value": "#96733F" },
      "900": { "$type": "color", "$value": "#5E4726" }
    },
    "neutral": {
      "0": { "$type": "color", "$value": "#FFFFFF" },
      "50": { "$type": "color", "$value": "#F7F5EF" },
