    },
    "border": {
      "hairline": { "$type": "color", "$value": "#171310", "$description": "Use at 14% opacity — rgba(23,19,16,0.14)" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Source Serif 4", "Georgia", "serif"] },
      "body": { "$type": "fontFamily", "$value": ["Work Sans", "Helvetica Neue", "Arial", "sans-serif"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}", "fontSize": "72px", "lineHeight": "1.08" }
    },
    "h1": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}", "fontSize": "48px", "lineHeight": "1.1" }
    },
    "h2": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}", "fontSize": "34px", "lineHeight": "1.15" }
    },
    "h3": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.regular}", "fontSize": "24px", "lineHeight": "1.25" }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.semibold}", "fontSize": "12px", "lineHeight": "1.3", "letterSpacing": "0.14em" }
    },
    "body-l": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "18px", "lineHeight": "1.55" }
    },
    "body": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "16px", "lineHeight": "1.6" }
    },
    "body-s": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "14px", "lineHeight": "1.55" }
